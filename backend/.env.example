SECRET_KEY=change-me-in-production-use-a-32-byte-plus-secret
OPENAI_API_KEY=your-openai-api-key
JWT_ACCESS_TOKEN_EXPIRES=86400
FLASK_ENV=development
FLASK_DEBUG=false
DEMO_MODE=auto
MAX_UPLOAD_BYTES=10485760
CODE_EXEC_TIMEOUT=45

# Optional admin bootstrap (created/updated on every backend start)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@prysm.local
ADMIN_PASSWORD=change-me-admin-password

USE_S3=false
S3_BUCKET=prysm-data
AWS_REGION=ap-southeast-2

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Optional: override data/DB location
# PRYSM_DATA_DIR=/var/lib/prysm
# DATABASE_PATH=/var/lib/prysm/prysm.db
